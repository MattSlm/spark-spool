# context/Makefile.context

SPARK_HOME ?= /opt/spark
SPARK_SPOOL_CONTEXT_MAINDIR ?= /tmp/spool-contexts

CONTEXT_ROOT := $(dir $(realpath $(lastword $(MAKEFILE_LIST))))
CONTEXT_ID ?=
SPOOL_CONF_PATH ?=
MODE ?= direct

CONTEXT_DIR := $(SPARK_SPOOL_CONTEXT_MAINDIR)/$(CONTEXT_ID)
SPOOL_CONF := $(SPARK_HOME)/conf/$(CONTEXT_ID)/spool-spark-default.conf
MANIFEST_DIR := $(CONTEXT_ROOT)/manifest

HELPER_FILES := $(strip $(abspath $(strip $(CONTEXT_ROOT)/../local-conf/helper-files)))
.PHONY: all create-context finalize-context compile-context create-manifest check-context check-manifest purge-manifest check-env install-default-spool-conf

# ========================
# Help
# ========================
all:
	    @echo "Available targets:"
	    @echo "  make -f Makefile.context create-context CONTEXT_ID=x [SPOOL_CONF_PATH=path]"
	    @echo "  make -f Makefile.context finalize-context CONTEXT_ID=x"
	    @echo "  make -f Makefile.context compile-context CONTEXT_ID=x [SPOOL_CONF_PATH=path]"
	    @echo "  make -f Makefile.context create-manifest CONTEXT_ID=x MODE=native/direct/sgx"
	    @echo "  make -f Makefile.context check-context CONTEXT_ID=x"
	    @echo "  make -f Makefile.context check-manifest CONTEXT_ID=x"
	    @echo "  make -f Makefile.context purge-manifest CONTEXT_ID=x"
	    @echo "  make -f Makefile.context check-env"
	    @echo "  make -f Makefile.context install-default-spool-conf"

# ========================
# Context Management
# ========================

create-context:
	    @echo "🛠️ Creating context $(CONTEXT_ID)..."
	    SPARK_SPOOL_CONTEXT_MAINDIR=$(SPARK_SPOOL_CONTEXT_MAINDIR) \
	    SPARK_HOME=$(SPARK_HOME) \
	    bash $(CONTEXT_ROOT)/create_context.sh "$(CONTEXT_ID)" "$(SPOOL_CONF_PATH)"
	    @$(MAKE) -f $(CONTEXT_ROOT)/Makefile.context check-context CONTEXT_ID=$(CONTEXT_ID)
	    @$(MAKE) -f $(CONTEXT_ROOT)/Makefile.context check-env

finalize-context:
	    @echo "🛠️ Finalizing context $(CONTEXT_ID)..."
	    SPARK_SPOOL_CONTEXT_MAINDIR=$(SPARK_SPOOL_CONTEXT_MAINDIR) \
	    SPARK_HOME=$(SPARK_HOME) \
	    bash $(CONTEXT_ROOT)/finalize_context.sh "$(CONTEXT_ID)"
	    @$(MAKE) -f $(CONTEXT_ROOT)/Makefile.context check-context CONTEXT_ID=$(CONTEXT_ID)
	    @$(MAKE) -f $(CONTEXT_ROOT)/Makefile.context check-env

compile-context:
	    @echo "🚀 Compiling full context flow for $(CONTEXT_ID)..."
	    @$(MAKE) -f $(CONTEXT_ROOT)/Makefile.context create-context CONTEXT_ID=$(CONTEXT_ID) SPOOL_CONF_PATH=$(SPOOL_CONF_PATH)
	    @$(MAKE) -f $(CONTEXT_ROOT)/Makefile.context finalize-context CONTEXT_ID=$(CONTEXT_ID)
	    @$(MAKE) -f $(CONTEXT_ROOT)/Makefile.context create-manifest CONTEXT_ID=$(CONTEXT_ID) MODE=$(MODE)
	    @$(MAKE) -f $(CONTEXT_ROOT)/Makefile.context check-context CONTEXT_ID=$(CONTEXT_ID)
	    @$(MAKE) -f $(CONTEXT_ROOT)/Makefile.context check-manifest CONTEXT_ID=$(CONTEXT_ID)
	    @$(MAKE) -f $(CONTEXT_ROOT)/Makefile.context check-env
	    @echo "✅ Context $(CONTEXT_ID) fully compiled and validated."

purge-manifest:
	    @echo "🧹 Purging manifests for context $(CONTEXT_ID)..."
	    $(MAKE) -C $(MANIFEST_DIR) -f Makefile.manifest clean CONTEXT_ID=$(CONTEXT_ID) SPARK_HOME=$(SPARK_HOME)

# ========================
# Manifest Management
# ========================

create-manifest: copy-helper-files install-default-spool-conf
	    @echo "🔧 Building manifest for context $(CONTEXT_ID) in mode $(MODE)..."
	    $(MAKE) -C $(MANIFEST_DIR) -f Makefile.manifest CONTEXT_ID=$(CONTEXT_ID) MODE=$(MODE) SPARK_HOME=$(SPARK_HOME)
	    @$(MAKE) -f $(CONTEXT_ROOT)/Makefile.context check-manifest CONTEXT_ID=$(CONTEXT_ID)

check-manifest:
	    @echo "🔍 Checking manifest outputs for context $(CONTEXT_ID)..."
	    @if [ ! -f "$(CONTEXT_DIR)/java.manifest" ]; then \
	            echo "❌ Manifest missing!"; exit 1; \
	    else \
	            echo "✅ Manifest file exists."; \
	    fi
ifeq ($(MODE),sgx)
	    @if [ ! -f "$(CONTEXT_DIR)/java.manifest.sgx" ]; then \
	            echo "❌ manifest.sgx missing!"; exit 1; \
	    else \
	            echo "✅ manifest.sgx exists."; \
	    fi
	    @if [ ! -f "$(CONTEXT_DIR)/java.manifest.sig" ]; then \
	            echo "❌ manifest.sig missing!"; exit 1; \
	    else \
	            echo "✅ manifest.sig exists."; \
	    fi
endif

# ========================
# Context Health Check
# ========================

check-context:
	    @echo "🔍 Checking context $(CONTEXT_ID)..."
	    @if [ ! -d "$(CONTEXT_DIR)" ]; then \
	            echo "❌ Context directory missing: $(CONTEXT_DIR)"; exit 1; \
	    fi
	    @if [ ! -f "$(CONTEXT_DIR)/.spool-env.sh" ]; then \
	            echo "❌ .spool-env.sh missing in context"; \
	    else \
	            echo "✅ .spool-env.sh found."; \
	    fi
	    @if [ ! -f "$(SPOOL_CONF)" ]; then \
	            echo "❌ spool-spark-default.conf missing!"; \
	    else \
	            echo "✅ spool-spark-default.conf found. Current settings:"; \
	            cat "$(SPOOL_CONF)"; \
	    fi
	    @if [ ! -f "$(CONTEXT_DIR)/manifest" ]; then \
	            echo "⚠️ Manifest missing!"; \
	    else \
	            echo "✅ Manifest exists."; \
	    fi
	    @echo "📂 Context directory structure:"
	    tree -L 2 "$(CONTEXT_DIR)" || true

# ========================
# Environment Health Check
# ========================

check-env:
	    @echo "🔍 Checking global Spark Spool environment variables..."
	    @if [ -z "$(SPARK_SPOOL_CONTEXT_MAINDIR)" ]; then \
	            echo "⚠️ SPARK_SPOOL_CONTEXT_MAINDIR missing. Will fallback to /tmp/spool-contexts."; \
	    else \
	            echo "✅ SPARK_SPOOL_CONTEXT_MAINDIR = $(SPARK_SPOOL_CONTEXT_MAINDIR)"; \
	    fi
	    @if [ -z "$(SPARK_HOME)" ]; then \
	            echo "❌ SPARK_HOME missing. Please set it explicitly."; \
	            exit 1; \
	    else \
	            echo "✅ SPARK_HOME = $(SPARK_HOME)"; \
	    fi

# ========================
# Install Default Spool Configs
# ========================

install-default-spool-conf:
	    @if [ -z "$(SPARK_HOME)" ]; then \
	            echo "❌ SPARK_HOME not set. Cannot install default spool configs."; exit 1; \
	    fi
	    @echo "🔧 Installing default spool conf files into $(SPARK_HOME)/conf/spool/"
	    @mkdir -p "$(SPARK_HOME)/conf/spool"
	    @for f in $(CONTEXT_ROOT)/../local-conf/*.spool; do \
	            dst="$(SPARK_HOME)/conf/spool/$$(basename $${f})"; \
	            echo "📋 Overwriting: $$dst"; \
	            cp "$$f" "$$dst"; \
	    done

copy-helper-files:
	    @echo "makefile list for debug: $(MAKEFILE_LIST)"
	    @echo "makefile list lastword for debug: $(lastword $(MAKEFILE_LIST))"
	    @echo "📂 Syncing helper-files into context $(CONTEXT_ID)..."
	    @mkdir -p "$(CONTEXT_DIR)/helper-files"
	    @for f in $(shell ls -1 $(HELPER_FILES)); do \
	            src="$(HELPER_FILES)/$$f"; \
	            dst="$(CONTEXT_DIR)/helper-files/$$f"; \
	            if [ -f "$$dst" ]; then \
	                    echo "🗑️   Removing old helper file: $$dst"; \
	                    rm -f "$$dst"; \
	            fi; \
	            echo "📋 Copying $$src to $$dst"; \
	            cp "$$src" "$$dst"; \
	    done
