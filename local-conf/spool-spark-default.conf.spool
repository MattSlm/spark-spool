# ========== Manifest Settings ==========
spool.loader.log_level=error
spool.loader.log_file=loader.log
spool.stack.size=2M
spool.brk.size=512M
spool.fds_limit=4096
spool.enable.sigterm=true
spool.disable.aslr=false
spool.disallow.subprocesses=false
spool.sgx.edmm_enable=true
spool.sgx.max_threads=256
spool.sgx_enclave_size=4G
spool.arch_libdir=/lib/x86_64-linux-gnu
spool.entrypoint=/usr/lib/jvm/java-11-openjdk-amd64/bin/java

# ========== Spark JVM Settings ==========
spool.spark.executor.memory.gb=6
spool.spark.executor.memory.overhead.gb=1
spool.spark.driver.memory.gb=4
spool.spark.driver.memory.overhead.gb=0
spool.spark.worker.memory.gb=7
spool.spark.worker.cores=2
spool.spark.master.port=7077
# spool.spark.master.webui.port will be dynamically allocated if missing
spool.spark.local.dirs=/scratch/\${CONTEXT_ID}
spool.spark.log.dir=logs/\${CONTEXT_ID}
spool.spark.log.maxfiles=10
spool.spark.log.maxsize=100m
spool.spark.gc.opts=-XX:+UseParallelGC -XX:+UseParallelOldGC
spool.spark.daemon.memory=6g
spool.spark.daemon.java.opts=-XX:+UseParallelGC -XX:+UseParallelOldGC

# ========== Logging and History Behavior ==========
spool.spark.event_log.enabled=false
spool.spark.history_log.enabled=false
